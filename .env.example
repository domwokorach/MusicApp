# Copy to .env (git-ignored) and restart with `npx expo start --clear`.
# EXPO_PUBLIC_* values are bundled into the app: never put secrets here.

# URL of the Sonara backend (see /backend). It serves Jamendo AND handles Spotify sign-in.
#   iOS simulator / web: http://localhost:4000
#   Android emulator:    http://10.0.2.2:4000
#   Physical device:     your deployed backend (https://...) or an HTTPS tunnel
# Leave empty to use the bundled offline demo catalogue (no Spotify).
EXPO_PUBLIC_API_URL=
