# Copy to backend/.env (git-ignored). NEVER commit the real file.

# --- Jamendo ---
JAMENDO_CLIENT_ID=YOUR_CLIENT_ID
JAMENDO_CLIENT_SECRET=YOUR_CLIENT_SECRET

# --- Spotify sign-in (podcasts, recently played, ...) ---
SPOTIFY_CLIENT_ID=YOUR_SPOTIFY_CLIENT_ID
SPOTIFY_CLIENT_SECRET=YOUR_SPOTIFY_CLIENT_SECRET
# PUBLIC HTTPS origin of this backend, no trailing slash. The Spotify redirect URI is exactly
#   ${PUBLIC_BASE_URL}/auth/spotify/callback
# and that same string must be added under Redirect URIs in the Spotify developer dashboard.
# Not localhost, not exp://, not a custom scheme. For local testing use an HTTPS tunnel
# (e.g. `cloudflared tunnel --url http://localhost:4000`) and put its https URL here.
PUBLIC_BASE_URL=https://YOUR_BACKEND_DOMAIN
# Deep-link scheme(s) the app may be returned to after login (must match "scheme" in app.json).
APP_SCHEMES=sonara
# Optional: keep Spotify sessions across restarts (encrypted with AES-256-GCM). Use a long random key.
# TOKEN_STORE_FILE=/data/spotify-sessions.enc
# TOKEN_ENCRYPTION_KEY=

PORT=4000
# Comma-separated browser origins allowed by CORS (Expo web). Native apps send no Origin.
CORS_ORIGINS=http://localhost:8081
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=30
